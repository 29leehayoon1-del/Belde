extends SceneTree

var checks: int = 0

func check(condition: bool, label: String) -> void:
	checks += 1
	if not condition:
		push_error("FAILED: " + label)
		quit(1)
		assert(condition, label)

func choose_first(campaign, count: int) -> void:
	var pool: Array = campaign.available_candidates()
	check(pool.size() >= count, "recruitment has enough candidates")
	for i in range(count):
		check(bool(campaign.recruit(str(pool[i]["id"]))["ok"]), "recruit slot " + str(i))
	check(bool(campaign.confirm_recruits()["ok"]), "confirm recruits")

func _init() -> void:
	var CatalogScript = load("res://scripts/catalog.gd")
	var CampaignScript = load("res://scripts/campaign.gd")
	var catalog = CatalogScript.new()
	check(catalog.errors.is_empty(), "catalog loads every JSON document")
	check(catalog.characters.size() == 58, "58 character models")
	check(catalog.abilities.size() == 116, "116 ability implementations")
	for origin_and_count in [["Bar",6],["Kingdom",15],["Village",10],["Royal Capital",10],["Prison",12],["Monster General",5]]:
		check(catalog.candidates(origin_and_count[0]).size() == origin_and_count[1], "origin count " + origin_and_count[0])
	var seen: Dictionary = {}
	for character in catalog.characters:
		check(character["abilities"].size() == 2, "two abilities " + character["id"])
		check(float(character["stats"]["hp"]) > 0, "positive HP " + character["id"])
		for slot in [0,1]:
			var a: Dictionary = catalog.get_ability(str(character["id"]), slot)
			check(not a.is_empty() and not a["effects"].is_empty(), "authored effect " + a.get("id", ""))
			check(not seen.has(a["name"]), "unique ability name " + a["name"])
			seen[a["name"]] = true
			check(float(a["cooldown_seconds"]) >= 10 and float(a["cooldown_seconds"]) <= 28, "cooldown budget")
	for enemy in catalog.world["enemies"]:
		check(enemy["runtime_abilities"].size() == 2, "enemy ability count")
		for a in enemy["runtime_abilities"]:
			check(not a["effects"].is_empty(), "enemy effects authored")
	var campaign = CampaignScript.new(catalog)
	check(campaign.new_run("Bar")["ok"], "begin bar run")
	check(not campaign.confirm_recruits()["ok"], "cannot recruit zero")
	check(not campaign.recruit("CAP01")["ok"], "cannot recruit outside origin")
	choose_first(campaign, 2)
	check(campaign.stage == "story" and campaign.party.size() == 2, "two allies enter story")
	check(campaign.current_story()["dialogue"].size() == 4, "authored story dialogue")
	check(campaign.choose_story("show_orders")["ok"], "choose honesty")
	check(campaign.battle_modifiers()["crowns_bonus"] == 20, "choice changes resources")
	check(campaign.battle_finished(true,campaign.party.duplicate())["ok"], "gate victory")
	check(campaign.current_map_id() == "MAP02" and campaign.act == 2, "advance to ford")
	check(not campaign.battle_finished(true,campaign.party.duplicate())["ok"], "cannot resolve battle twice")
	campaign.choose_story("offer_parley")
	campaign.battle_finished(true,campaign.party.duplicate())
	check(campaign.stage == "generals" and campaign.recruit_limit == 2, "victory opens two general slots")
	choose_first(campaign,2)
	check(campaign.party.size() == 4 and campaign.current_map_id() == "MAP03", "two generals join")
	campaign.choose_story("rescue_families")
	campaign.battle_finished(false,campaign.party.duplicate())
	campaign.choose_story("open_prison")
	check(campaign.stage == "reinforce" and campaign.recruit_limit == 5, "gate loss offers five even with four survivors")
	choose_first(campaign,5)
	check(campaign.party.size() == 9, "all nine allies retained")
	campaign.choose_story("take_shortcut")
	check(campaign.current_map_id() == "MAP05", "optional road shortcut")
	campaign.choose_story("break_oaths")
	campaign.battle_finished(true,campaign.party.duplicate())
	campaign.choose_story("name_the_fallen")
	check(is_equal_approx(float(campaign.battle_modifiers()["enemy_hp_multiplier"]),.92), "final dialogue changes boss budget")
	campaign.battle_finished(true,campaign.party.duplicate())
	check(campaign.story_key == "judgment", "final victory opens moral decision")
	campaign.choose_story("forgive")
	check(campaign.stage == "ending" and campaign.ending_data["forgiven"], "forgiveness ending")
	check(campaign.ending_data["survivors"].size() == 9, "epilogue uses actual survivors")
	var saved: Dictionary = JSON.parse_string(JSON.stringify(campaign.snapshot()))
	var restored = CampaignScript.new(catalog)
	check(restored.restore(saved)["ok"], "v2 save restores")
	check(restored.party == campaign.party and restored.ending_data["title"] == campaign.ending_data["title"], "save retains roster and earned title")
	var invalid: Dictionary = saved.duplicate(true)
	invalid["party"] = ["BAR01","BAR01"]
	check(not restored.restore(invalid)["ok"], "duplicate roster rejected")
	invalid = saved.duplicate(true)
	invalid["version"] = 999
	check(not restored.restore(invalid)["ok"], "future save version rejected")
	invalid = saved.duplicate(true)
	invalid["party"] = ["DOES_NOT_EXIST"]
	check(not restored.restore(invalid)["ok"], "unknown character rejected")
	invalid = saved.duplicate(true)
	invalid["flags"]["crowns_bonus"] = {"not": "a number"}
	check(not restored.restore(invalid)["ok"], "malformed resource flag rejected")
	invalid = saved.duplicate(true)
	invalid["history"] = ["not a story event"]
	check(not restored.restore(invalid)["ok"], "malformed history rejected")
	check(restored.party == campaign.party, "failed restores leave the current campaign intact")
	var clean = CampaignScript.new(catalog)
	clean.new_run("Kingdom")
	choose_first(clean,2)
	clean.choose_story("stand_together")
	clean.battle_finished(true,clean.party.duplicate())
	clean.choose_story("hold_the_gate")
	clean.battle_finished(true,clean.party.duplicate())
	choose_first(clean,2)
	clean.choose_story("rescue_families")
	clean.battle_finished(true,clean.party.duplicate())
	clean.choose_story("hire_capital")
	check(clean.recruit_limit == 3, "victory with both originals offers three reinforcements")
	choose_first(clean,3)
	check(clean.party.size() == 7, "victory company retains seven allies")
	clean.choose_story("escort_road")
	clean.battle_finished(true,clean.party.duplicate())
	check(clean.battle_modifiers()["crowns_bonus"] == 75, "optional escort victory grants actual supplies")
	clean.choose_story("protect_wounded")
	clean.battle_finished(true,clean.party.duplicate())
	clean.choose_story("challenge_crown")
	clean.battle_finished(true,clean.party.duplicate())
	clean.choose_story("refuse_pardon")
	check(clean.stage == "ending" and clean.ending_data["ending_id"] == "refuse_pardon", "refusal ending after clean victory")
	check(not clean.ending_data["forgiven"] and clean.ending_data["won"], "refusal is a victory without forgiveness")
	check(not "Merciful" in clean.ending_data["earned_title_parts"]["epithets"], "mercy title requires actual mercy and pardon")
	var declined = CampaignScript.new(catalog)
	declined.new_run("Bar")
	choose_first(declined,2)
	declined.choose_story("show_orders")
	declined.battle_finished(true,declined.party.duplicate())
	declined.choose_story("offer_parley")
	declined.battle_finished(true,declined.party.duplicate())
	check(declined.choose_story("refuse_generals")["ok"], "general alliance can be declined")
	check(declined.party.size() == 2 and declined.story_key == "act3_rescue", "refusing generals preserves original allies and advances")
	var loss = CampaignScript.new(catalog)
	loss.new_run("Village")
	choose_first(loss,2)
	loss.choose_story("stand_together")
	loss.battle_finished(false,[])
	check(loss.party.is_empty() and loss.fallen.size() == 2, "casualties persist")
	check(loss.battle_modifiers()["empty_party_supply"] == 150, "empty company can still build recovery defenses")
	loss.choose_story("offer_parley")
	loss.battle_finished(false,[])
	check(loss.stage == "story" and loss.story_key == "act3_rescue", "defeat skips general recruitment")
	loss.choose_story("rescue_ally")
	check(loss.party.size() == 1 and loss.fallen.size() == 1, "rescue recovers one downed named ally")
	loss.battle_finished(false,loss.party.duplicate())
	loss.choose_story("hire_capital")
	check(loss.recruit_limit == 5, "one original survivor opens five recovery slots")
	choose_first(loss,5)
	loss.choose_story("escort_road")
	loss.battle_finished(false,loss.party.duplicate())
	loss.choose_story("protect_wounded")
	loss.battle_finished(false,loss.party.duplicate())
	loss.choose_story("challenge_crown")
	loss.battle_finished(false,loss.party.duplicate())
	check(loss.story_key == "defeat_finale", "final defeat has a playable next decision")
	loss.choose_story("rally_again")
	check(loss.stage == "battle" and loss.battle_modifiers()["crowns_bonus"] == 150, "rally resumes with extra defenses")
	loss.battle_finished(false,loss.party.duplicate())
	loss.choose_story("accept_defeat")
	check(loss.stage == "ending" and loss.ending_data["ending_id"] == "defeat", "retreat finishes a losing run")
	check(loss.ending_data["title"] != campaign.ending_data["title"], "choices and roster produce different titles")
	print("CAMPAIGN_SMOKE_PASS ", checks, " checks")
	quit(0)
