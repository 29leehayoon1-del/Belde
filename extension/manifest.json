{
  "manifest_version": 3,
  "name": "Belde \u2014 Connected Commander",
  "version": "0.1.0",
  "description": "The paired map and formation editor for Belde. The PC game owns the battle.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Belde Connected Commander",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}